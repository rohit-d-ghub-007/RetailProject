            steps {
                echo "build successfully"
            }
        }

        stage('Test') {
            steps {
                echo "tested successfully"
            }
        }

        stage('Package') {
            steps {
                echo "packaged successfully"
            }
        }

        stage('Deploy') {
            steps {
                echo "deployed successfully"
            }
        }
    }
}

